{
  "contest_type": "gpp_tournament",
  "name": "GPP Tournament",
  "description": "Large-field tournaments with top-heavy payouts",
  "optimization_settings": {
    "num_lineups": 20,
    "max_exposure": 0.4,
    "min_exposure": 0.1,
    "randomness": true,
    "min_salary_cap": 48500,
    "max_repeating_players": 6,
    "strategy": "ceiling"
  },
  "lineup_rules": {
    "unique_lineups": true,
    "min_unique_players": 3,
    "correlation_rules": {
      "allow_opposing_defense": false,
      "stack_rules": {
        "team_stack": {
          "enabled": true,
          "min_players": 2,
          "max_players": 4
        },
        "game_stack": {
          "enabled": true,
          "min_players_per_team": 1,
          "max_players_per_team": 3
        }
      }
    }
  },
  "player_settings": {
    "ownership_settings": {
      "use_projected_ownership": true,
      "fade_threshold": 0.35,
      "chalk_threshold": 0.25,
      "leverage_plays": {
        "enabled": true,
        "min_projection_percentile": 70,
        "max_ownership": 0.15
      }
    },
    "min_projected_points": 15.0,
    "exclude_injured": true,
    "exclude_questionable": false
  },
  "risk_settings": {
    "variance_weight": 0.3,
    "ceiling_weight": 0.7,
    "floor_weight": 0.0
  },
  "entry_settings": {
    "max_entries": 150,
    "entry_fee_range": {
      "min": 3,
      "max": 100
    }
  }
}